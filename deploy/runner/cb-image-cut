#!/bin/bash
# Cuts cbcore:<vN> from a release for the image workflow: a root-owned tree of the tag with the vendor tarballs and the release agent, then image/cut.sh.
# usage: sudo cb-image-cut [-p] <release tag> <base template> <vN>; the runner user may run only this with sudo (deploy/runner/install)
set -euo pipefail
export LC_ALL=C

REPO=loomhand/cocoonbox
ROOT=/var/lib/cb-image
COCOON=/srv/cb/sbx/bin/cocoon-cbsbx
AGENT=cocoonbox-agent-linux-amd64
HEADROOM_G=35
ROOT_FREE_G=10
USAGE="usage: cb-image-cut [-p] <release tag> <base template> <vN>"

die() { echo "cb-image-cut: $*" >&2; exit 1; }

PROVISION=()
while getopts p o; do
	case $o in
	p) PROVISION=(-p) ;;
	*) die "$USAGE" ;;
	esac
done
shift $((OPTIND - 1))
[ $# = 3 ] || die "$USAGE"
TAG=$1 BASE=$2 V=$3
[[ $TAG =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "release $TAG is not vX.Y.Z"
[[ $BASE =~ ^cbcore:v[0-9]+$ ]] || die "base $BASE is not cbcore:vN"
[[ $V =~ ^v[0-9]+$ ]] || die "version $V is not vN"
AUDIT=$(cat /etc/cocoonbox/image-audit)
SRC=$ROOT/src-$V

free=$(df --output=avail -BG / | tail -1 | tr -dc 0-9)
[ "$free" -ge "$ROOT_FREE_G" ] || die "only ${free}G free on /"
read -r used limit < <(xfs_quota -x -c "report -p -b -N" /srv/cb | awk '$1 == "cbsbx" {print int($2/1048576), int($4/1048576)}')
[ $((limit - used)) -ge "$HEADROOM_G" ] || die "cbsbx headroom $((limit - used))G is under ${HEADROOM_G}G"
templates=$("$COCOON" image list | awk 'NR > 1 {print $2}')
grep -qxF "$BASE" <<<"$templates" || die "no base template $BASE"
! grep -qxF "cbcore:$V" <<<"$templates" || die "template cbcore:$V exists"

[ -d "$ROOT/repo.git" ] || git clone -q --bare "https://github.com/$REPO.git" "$ROOT/repo.git"
git -C "$ROOT/repo.git" fetch -q origin "+refs/heads/main:refs/heads/main" "refs/tags/*:refs/tags/*"
rev=$(git -C "$ROOT/repo.git" rev-parse "$TAG^{commit}")
git -C "$ROOT/repo.git" merge-base --is-ancestor "$rev" main || die "$TAG ($rev) is not on main"

rm -rf "$SRC"
install -d -m 0700 "$SRC"
git -C "$ROOT/repo.git" archive "$rev" image | tar -x -C "$SRC"
install -d "$SRC/image/desk/vendor"
install -m 0644 "$ROOT"/vendor/*.tar.gz "$SRC/image/desk/vendor/"
curl -fsSL -o "$SRC/checksums.txt" "https://github.com/$REPO/releases/download/$TAG/checksums.txt"
curl -fsSL -o "$SRC/$AGENT" "https://github.com/$REPO/releases/download/$TAG/$AGENT"
(cd "$SRC" && grep " $AGENT\$" checksums.txt | sha256sum -c --quiet -)
chmod 0755 "$SRC/$AGENT"

printf '%s [image-cut] cbcore:%s from %s (%s), base %s, agent %s\n' "$(date -u +%FT%TZ)" "$V" "$TAG" "$rev" "$BASE" \
	"$(sha256sum "$SRC/$AGENT" | cut -c1-16)" | tee -a "$AUDIT"
AUDIT=$AUDIT "$SRC/image/cut.sh" "${PROVISION[@]}" -f cbcore -a "$SRC/$AGENT" "$BASE" "$V"
rm -rf "$SRC"
