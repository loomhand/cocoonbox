#!/bin/sh
# usage: cb-host-net up|down
set -eu

UPLINK=ens8
HOST_IP=$(ip -4 -o addr show dev "$UPLINK" | awk '{print $4}' | cut -d/ -f1)
BRIDGE=cbc0
BRIDGE_ADDR=10.203.0.1/24
CLUSTER_CIDR=10.42.0.0/15
GW_PORT=18090

up() {
	ip link show "$BRIDGE" >/dev/null 2>&1 || ip link add "$BRIDGE" type bridge
	ip -4 addr show dev "$BRIDGE" | grep -q "inet $BRIDGE_ADDR" || ip addr add "$BRIDGE_ADDR" dev "$BRIDGE"
	ip link set "$BRIDGE" up

	iptables -N CB-INPUT 2>/dev/null || iptables -F CB-INPUT
	iptables -A CB-INPUT -i "$UPLINK" -p tcp -m multiport --dports 5000,6443,10250,10260,$GW_PORT,18200 ! -s "$HOST_IP" -j DROP
	iptables -A CB-INPUT -i "$UPLINK" -p udp --dport 8472 ! -s "$HOST_IP" -j DROP
	iptables -A CB-INPUT -i "$BRIDGE" -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
	iptables -A CB-INPUT -i "$BRIDGE" -p tcp --dport "$GW_PORT" -j RETURN
	iptables -A CB-INPUT -i "$BRIDGE" -j DROP
	iptables -C INPUT -j CB-INPUT 2>/dev/null || iptables -I INPUT 1 -j CB-INPUT

	iptables -t mangle -N CB-PREROUTING 2>/dev/null || iptables -t mangle -F CB-PREROUTING
	iptables -t mangle -A CB-PREROUTING -i "$BRIDGE" -d "$CLUSTER_CIDR" -j DROP
	iptables -t mangle -C PREROUTING -j CB-PREROUTING 2>/dev/null || iptables -t mangle -I PREROUTING 1 -j CB-PREROUTING
}

down() {
	while iptables -D INPUT -j CB-INPUT 2>/dev/null; do :; done
	while iptables -t mangle -D PREROUTING -j CB-PREROUTING 2>/dev/null; do :; done
	iptables -F CB-INPUT 2>/dev/null && iptables -X CB-INPUT || true
	iptables -t mangle -F CB-PREROUTING 2>/dev/null && iptables -t mangle -X CB-PREROUTING || true
}

case "${1:-}" in
up) up ;;
down) down ;;
*) echo "usage: $0 up|down" >&2; exit 2 ;;
esac
