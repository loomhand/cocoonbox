#!/bin/sh
# garbage-collects the box registry while no box is creating or hibernating; the registry is stopped for the sweep
set -eu

UPLINK=ens8
NS=cb-system
DEPLOY=registry
SELECTOR=app.kubernetes.io/name=registry
DATA=/srv/cb/registry
IMAGE=docker.io/library/registry:3
CONFIG=/etc/distribution/config.yml
HOST_IP=$(ip -4 -o addr show dev "$UPLINK" | awk '{print $4}' | cut -d/ -f1)
REGISTRY=http://$HOST_IP:5000
K="k3s kubectl"

log() { logger -t cb-registry-gc -- "$*" 2>/dev/null || true; echo "$*"; }

busy() {
	$K get pods -A -o jsonpath='{range .items[*]}{.metadata.annotations.vm\.cocoonstack\.io/lifecycle-state}{"\n"}{end}' |
		grep -cxE 'creating|hibernating' || true
}

gc() {
	k3s ctr -n k8s.io run --rm --mount "type=bind,src=$DATA,dst=/var/lib/registry,options=rbind:rw" \
		"$IMAGE" "cb-registry-gc-$$" registry garbage-collect --delete-untagged "$@" "$CONFIG" 2>&1
}

resume() {
	$K -n "$NS" scale deploy "$DEPLOY" --replicas=1 >/dev/null
	$K -n "$NS" rollout status deploy "$DEPLOY" --timeout=120s >/dev/null
	for _ in $(seq 60); do curl -sf -o /dev/null "$REGISTRY/v2/" && return 0; sleep 1; done
	log "registry did not come back"
	return 1
}

verify() {
	python3 - "$REGISTRY" <<'PY'
import json, sys, urllib.error, urllib.request
base = sys.argv[1]
accept = "application/vnd.oci.image.manifest.v1+json, application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.v2+json"
def get(path, method="GET"):
    req = urllib.request.Request(base + path, method=method, headers={"Accept": accept})
    with urllib.request.urlopen(req) as r:
        return r.status, r.read() if method == "GET" else b""
bad = 0
for repo in json.loads(get("/v2/_catalog?n=1000")[1])["repositories"]:
    try:
        tags = json.loads(get(f"/v2/{repo}/tags/list")[1]).get("tags") or []
    except urllib.error.HTTPError:
        tags = []
    for tag in tags:
        m = json.loads(get(f"/v2/{repo}/manifests/{tag}")[1])
        blobs = [m["config"]] + m.get("layers", [])
        missing = 0
        for b in blobs:
            try:
                missing += get(f"/v2/{repo}/blobs/{b['digest']}", "HEAD")[0] != 200
            except Exception:
                missing += 1
        bad += missing
        print(f"{repo}:{tag} manifest 200, blobs {len(blobs) - missing}/{len(blobs)} 200")
sys.exit(1 if bad else 0)
PY
}

[ "$(busy)" = 0 ] || { log "skip: a box is creating or hibernating"; exit 0; }
out=$(gc --dry-run) || { log "dry run failed: $(printf '%s' "$out" | tail -1)"; exit 1; }
n=$(printf '%s\n' "$out" | grep -cE '(blob|manifest) eligible for deletion:' || true)
[ "$n" -gt 0 ] || { log "nothing to collect"; exit 0; }

before=$(du -sm "$DATA" | cut -f1)
$K -n "$NS" scale deploy "$DEPLOY" --replicas=0 >/dev/null
trap resume EXIT
$K -n "$NS" wait --for=delete pod -l "$SELECTOR" --timeout=60s >/dev/null 2>&1 || true
[ "$(busy)" = 0 ] || { log "skip: a box started hibernating during the pause"; exit 0; }
gc >/dev/null
trap - EXIT
resume
log "collected $n objects, freed $((before - $(du -sm "$DATA" | cut -f1))) MiB"
verify
