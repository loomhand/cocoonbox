VK_NODE_NAME=cocoon-cb
VK_NODE_IP=__HOST_IP__
VK_KUBELET_PORT=10260
VK_COCOON_BIN=/usr/local/bin/cocoon-cb
COCOON_ROOT_DIR=/srv/cb/cocoon
VK_COCOON_SNAPSHOT_DIR=/srv/cb/cocoon/snapshot/localfile
VK_STAGING_DIR=/srv/cb/cocoon/vk-staging
COCOON_CGROUP_PARENT=cb.slice
OCI_REGISTRY=__HOST_IP__:5000/cb
VK_ORPHAN_POLICY=alert
VK_RESTORE_MODE=mmap
VK_METRICS_ADDR=127.0.0.1:9191
VK_PEER_ADDR=127.0.0.1:12511
VK_NODE_CPU=8
VK_NODE_MEM=24Gi
VK_RESERVE_PERCENT=0
VK_LOG_LEVEL=info
VK_NODE_STORAGE=160Gi
