[Unit]
Description=cocoonbox state store (MinIO, S3 on the cb bridge)
Requires=cb-host-net.service
After=cb-host-net.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/cb/state

[Service]
Type=simple
User=minio-cb
Group=minio-cb
EnvironmentFile=/etc/cocoonbox/minio.env
Environment=MINIO_BROWSER=off
Environment=MINIO_UPDATE=off
ExecStart=/usr/local/bin/minio-cb server /srv/cb/state --address 10.203.0.1:9000 --console-address 127.0.0.1:9001
Restart=always
RestartSec=2s
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/srv/cb/state

[Install]
WantedBy=multi-user.target
