#!/bin/sh
# Per-box gw access keys: add|revoke|list. Mechanism only; the api decides when to call it.
# As a socket-activated service it reads one request line ("<verb> [box-id]") from stdin.
set -eu

KEY_DIR=${CB_GW_KEY_DIR:-/etc/gw/box-keys}
RENDER=${CB_GW_RENDER:-/usr/local/sbin/install-gw-config}
RELOAD=${CB_GW_RELOAD:-1}
LOCK=${CB_GW_LOCK:-/run/cb-gw-key.lock}
ID_RE='^cb-[0-9a-f]{12}(-r[0-9a-z]+)?$'

log() { logger -t cb-gw-key -- "$*" 2>/dev/null || true; }
fail() { echo "error $*"; log "refused: $*"; exit 1; }

if [ $# -gt 0 ]; then
	verb=$1 id=${2:-}
else
	IFS=' ' read -r verb id rest || true
	[ -z "${rest:-}" ] || fail "unexpected arguments"
fi

case "$verb" in
add | revoke)
	printf '%s\n' "$id" | grep -Eq "$ID_RE" || fail "invalid box id"
	;;
list)
	[ -z "$id" ] || fail "list takes no box id"
	;;
*) fail "unknown verb" ;;
esac

install -d -m 0700 "$KEY_DIR"
exec 9>"$LOCK"
flock 9

apply() {
	"$RENDER" >/dev/null
	[ "$RELOAD" = 1 ] && systemctl kill -s HUP gw
	return 0
}

case "$verb" in
add)
	if [ ! -s "$KEY_DIR/$id" ]; then
		tmp=$(mktemp "$KEY_DIR/.$id.XXXXXX")
		python3 -c 'import secrets, string; a = string.ascii_letters + string.digits; print("cb-" + "".join(secrets.choice(a) for _ in range(45)))' > "$tmp"
		chmod 0600 "$tmp"
		mv -f "$tmp" "$KEY_DIR/$id"
		apply
		log "add $id (new)"
	else
		log "add $id (existing)"
	fi
	echo "ok $(cat "$KEY_DIR/$id")"
	;;
revoke)
	if [ -e "$KEY_DIR/$id" ]; then
		rm -f "$KEY_DIR/$id"
		apply
		log "revoke $id"
	else
		log "revoke $id (absent)"
	fi
	echo ok
	;;
list)
	echo ok
	ls "$KEY_DIR" | grep -E "$ID_RE" || true
	log "list"
	;;
esac
