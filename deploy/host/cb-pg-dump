#!/bin/sh
# nightly pg_dump of every database on the local cluster; keeps the newest KEEP dumps per database
set -eu

DIR=${CB_PG_DUMP_DIR:-/var/backups/cb-pg}
KEEP=7

umask 077
stamp=$(date -u +%Y%m%dT%H%M%SZ)
for db in $(psql -XAtc "SELECT datname FROM pg_database WHERE NOT datistemplate AND datname <> 'postgres' ORDER BY 1"); do
	pg_dump -Fc -f "$DIR/.$db-$stamp.dump" "$db"
	mv "$DIR/.$db-$stamp.dump" "$DIR/$db-$stamp.dump"
	ls -1 "$DIR" | grep -E "^$db-[0-9]{8}T[0-9]{6}Z\.dump\$" | sort -r | tail -n +$((KEEP + 1)) | while read -r old; do rm -f "$DIR/$old"; done
	logger -t cb-pg-dump -- "dumped $db ($(stat -c %s "$DIR/$db-$stamp.dump") bytes)" 2>/dev/null || true
done
