(cocoonbox_pair) {
	lb_policy header x-cocoonbox-box
	lb_try_duration 10s
	lb_try_interval 250ms
	fail_duration 10s
}

(cocoonbox_health) {
	health_uri /healthz
	health_interval 1s
	health_timeout 2s
}

http://10.203.0.1:18091 {
	bind 10.203.0.1
	reverse_proxy 127.0.0.1:18212 127.0.0.1:18222 {
		import cocoonbox_pair
	}
}

