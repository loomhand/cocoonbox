#!/bin/sh
# usage: cb-disk-alert; journals the use of /, /srv/cb and each XFS project quota on /srv/cb, and whether sandboxd refuses work
# at capacity, and runs cb-alert when one changes level (ok, WARN at 70%, CRIT at 85% or at capacity) or stays above ok for an hour
set -u
WARN=70
CRIT=85
REPEAT=3600
STATE=/run/cb-disk-alert

now=$(date +%s)
touch "$STATE"
next=$(mktemp)

check() {
	name=$1 pct=$2
	level=ok
	[ "$pct" -ge "$WARN" ] && level=WARN
	[ "$pct" -ge "$CRIT" ] && level=CRIT
	track "$name" "$level" "disk $name at ${pct}% (warn ${WARN}%, crit ${CRIT}%)"
}

track() {
	name=$1 level=$2 detail=$3
	logger -p user.info -t cb-disk-alert "$detail: $level"
	last=$(awk -v n="$name" '$1 == n { print $2 }' "$STATE")
	sent=$(awk -v n="$name" '$1 == n { print $3 }' "$STATE")
	last=${last:-ok} sent=${sent:-0}
	if [ "$level" != "$last" ] || { [ "$level" != ok ] && [ $((now - sent)) -ge "$REPEAT" ]; }; then
		if cb-alert "$detail: $level (was $last)"; then
			sent=$now
		else
			level=$last
		fi
	fi
	echo "$name $level $sent" >> "$next"
}

for m in / /srv/cb; do
	check "$m" "$(df --output=pcent "$m" | tail -1 | tr -dc 0-9)"
done
xfs_quota -x -c 'report -p -b -N' /srv/cb 2>/dev/null > "$next.q"
while read -r name used _ hard _; do
	if [ "$hard" -gt 0 ] 2>/dev/null; then
		check "project:$name" $((used * 100 / hard))
	fi
done < "$next.q"
info=$(printf 'header = "Authorization: Bearer %s"\n' "$(cat /etc/cocoonbox/sandboxd-token)" |
	curl -fsS -m 5 -K - http://127.0.0.1:17780/v1/info 2>/dev/null)
reason=$(printf '%s' "$info" | python3 -c 'import json, sys; i = json.load(sys.stdin); print(i.get("at_capacity_reason", "at capacity") if i.get("at_capacity") else "")' 2>/dev/null) ||
	reason="/v1/info unreachable"
if [ -n "$reason" ]; then
	track sandboxd CRIT "sandboxd refuses work ($reason)"
else
	track sandboxd ok "sandboxd admits work"
fi
mv "$next" "$STATE"
rm -f "$next.q"
