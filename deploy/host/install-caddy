#!/bin/bash
# Installs Caddy from its official apt repository and serves the cocoonbox routes (Caddyfile.cocoonbox) on CB_DOMAIN with an
# automatic certificate, every other path answering 404; idempotent. Without CB_DOMAIN it only validates the site.
# usage: sudo CB_DOMAIN=<name> deploy/host/install-caddy
set -euo pipefail
export LC_ALL=C DEBIAN_FRONTEND=noninteractive

KEYRING=/usr/share/keyrings/caddy-stable-archive-keyring.gpg
LIST=/etc/apt/sources.list.d/caddy-stable.list
SRC="$(cd "$(dirname "$0")" && pwd)"
TMP=$(mktemp -d)

trap 'rm -rf "$TMP"' EXIT
if ! command -v caddy >/dev/null; then
	[ -s "$KEYRING" ] || curl -fsSL https://dl.cloudsmith.io/public/caddy/stable/gpg.key | gpg --dearmor -o "$KEYRING"
	[ -s "$LIST" ] || curl -fsSL https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt > "$LIST"
	apt-get update -q >/dev/null
	apt-get install -y -q caddy >/dev/null
fi
install -d -m 0755 /etc/systemd/system/caddy.service.d
printf '[Service]\nRestart=on-failure\nRestartSec=5s\nOOMScoreAdjust=-900\n' > /etc/systemd/system/caddy.service.d/restart.conf
systemctl daemon-reload

{ echo "${CB_DOMAIN:-example.com} {"; cat "$SRC/Caddyfile.cocoonbox"; printf '\thandle {\n\t\trespond 404\n\t}\n}\n'; } > "$TMP/Caddyfile"
caddy validate --config "$TMP/Caddyfile" --adapter caddyfile >/dev/null
if [ -z "${CB_DOMAIN:-}" ]; then
	echo "caddy: the site validates; set CB_DOMAIN to install it"
	exit 0
fi
[ ! -s /etc/caddy/Caddyfile ] || cmp -s "$TMP/Caddyfile" /etc/caddy/Caddyfile || cp -p /etc/caddy/Caddyfile "/etc/caddy/Caddyfile.bak-$(date -u +%Y%m%dT%H%M%SZ)"
install -m 0644 "$TMP/Caddyfile" /etc/caddy/Caddyfile
systemctl enable caddy >/dev/null
systemctl reload-or-restart caddy
echo "caddy: serving $CB_DOMAIN"
