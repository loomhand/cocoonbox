#!/usr/bin/env python3
"""usage: cb-lists-to-users API_YAML [CONFIG]

Prints the commands that carry the per-user lists of an old api.yaml (image_owners, state.delta_users, state.park_owners,
state.gc.users) into the users table, for an api from the release that drops those keys; CONFIG is the -config path the
commands name (default /etc/cocoonbox/api.yaml). It runs nothing. Run the printed user set commands with the new binary
before its first start; they apply the users migration. A non-empty park_owners or gc.users list printed as SQL marks
every other user, since the table keeps opt-outs."""

import sys

import yaml


def main():
    if len(sys.argv) not in (2, 3):
        sys.exit(__doc__)
    with open(sys.argv[1]) as f:
        cfg = yaml.safe_load(f) or {}
    config = sys.argv[2] if len(sys.argv) == 3 else "/etc/cocoonbox/api.yaml"
    user_set = f"cocoonbox-api -config {config} user set"
    offered = {cfg.get("image")} | set(cfg.get("rebase_images") or [])
    for image, owners in sorted((cfg.get("image_owners") or {}).items()):
        if image not in offered:
            print(f"# {image} is not offered, so its owners {owners} start from the default image: nothing to set")
            continue
        for user in owners:
            print(f"{user_set} {user} -image {image}")
    state = cfg.get("state") or {}
    for user in state.get("delta_users") or []:
        print(f"{user_set} {user} -delta")
    for name, listed, column in (("state.park_owners", state.get("park_owners"), "no_park"),
                                 ("state.gc.users", (state.get("gc") or {}).get("users"), "no_gc")):
        if listed:
            ids = ",".join(listed)
            print(f"# {name} named only {listed}; after the user set commands, in the users database:")
            print(f"UPDATE users SET {column} = true WHERE NOT (id = ANY('{{{ids}}}'));")


if __name__ == "__main__":
    main()
