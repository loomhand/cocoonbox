#!/usr/bin/env python3
"""Ship appended sandboxd audit and usage journal lines to cocoonbox-logs through cb-s3."""

import gzip
import json
import os
import socket
import subprocess
import sys
import time
from typing import BinaryIO

DATA = "/srv/cb/sbx/data"
JOURNALS = ("audit.jsonl", "usage.jsonl")
BUCKET = "cocoonbox-logs"
STATE = "/var/lib/cb-log-ship/state.json"
MAX_CHUNK = 64 << 20


def put(key: str, body: bytes) -> None:
    subprocess.run(["cb-s3", "put", BUCKET, key, "-"], input=gzip.compress(body), check=True)


def whole_lines(f: BinaryIO, offset: int) -> bytes:
    f.seek(offset)
    data = f.read(MAX_CHUNK)
    return data[: data.rfind(b"\n") + 1]


def drain(host: str, name: str, f: BinaryIO, pos: dict[str, int]) -> None:
    while chunk := whole_lines(f, pos["offset"]):
        day = time.strftime("%Y/%m/%d", time.gmtime())
        put(f"sandboxd/{host}/{name.removesuffix('.jsonl')}/{day}/{pos['ino']}-{pos['offset']:012d}.jsonl.gz", chunk)
        pos["offset"] += len(chunk)


def ship(host: str, name: str, pos: dict[str, int]) -> None:
    path = os.path.join(DATA, name)
    with open(path, "rb") as f:
        ino = os.fstat(f.fileno()).st_ino
        if pos.get("ino") not in (None, ino):
            rotated = path + ".1"
            found = False
            if os.path.exists(rotated):
                with open(rotated, "rb") as previous:
                    if os.fstat(previous.fileno()).st_ino == pos["ino"]:
                        drain(host, name, previous, pos)
                        found = True
            if not found:
                subprocess.run(
                    ["cb-alert", f"cb-log-ship: {name} rotated twice since the last run; lines lost"], check=False
                )
            pos.clear()
        pos.setdefault("ino", ino)
        pos.setdefault("offset", 0)
        drain(host, name, f, pos)


def main() -> None:
    host = socket.gethostname().split(".")[0]
    try:
        with open(STATE) as f:
            state = json.load(f)
    except FileNotFoundError:
        state = {}
    failed = []
    for name in JOURNALS:
        pos = state.setdefault(name, {})
        try:
            ship(host, name, pos)
        except (OSError, subprocess.CalledProcessError) as e:
            failed.append(f"{name}: {e}")
        os.makedirs(os.path.dirname(STATE), mode=0o700, exist_ok=True)
        with open(STATE + ".tmp", "w") as f:
            json.dump(state, f)
        os.replace(STATE + ".tmp", STATE)
    if failed:
        subprocess.run(["cb-alert", "cb-log-ship failed: " + "; ".join(failed)], check=False)
        sys.exit(1)


if __name__ == "__main__":
    main()
