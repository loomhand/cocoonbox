listen: 127.0.0.1:18200
mcp_listen: 127.0.0.1:18201
# relative paths resolve next to this file (the systemd credentials directory)
image: cbdesk:v11            # the default sandboxd template
rebase_images: []            # older templates Rebase may also target; anything else is refused
agent_port: 7443
sandboxd:
  url: http://127.0.0.1:17780
  token_file: sandboxd-token   # the instance's root api_token
  tenant_egress_class: ""      # egress class of every user's tenant; set, machines claim under the user's tenant
flavor:
  vcpus: 4
  memory_mib: 8192
  disk_gib: 40
flavors: []                  # flavors Ensure accepts besides the default one; anything else is refused
state:
  endpoint: 10.203.0.1:9000
  bucket: cocoonbox-state
  region: us-east-1
  credentials_file: store.env    # STORE_ACCESS_KEY=... / STORE_SECRET_KEY=...
  keyring_dir: /var/lib/cocoonbox-api/keys
  interval: 15m
  presign_ttl: 10m
provision:                     # every box's identity file (design §12) and its user's gw key
  signing_key_file: edge-signing.key   # PEM PKCS#8 ed25519: openssl genpkey -algorithm ed25519
  gw_admin:                    # per-user gw keys through gw's admin API
    url: http://10.203.0.1:18090
    token_file: gw-admin-token # the cocoonbox-boxes tenant admin token
accounts:                      # users, console sessions and each user's sealed gw key and tenant token (design §22)
  dsn_file: pg.dsn             # postgres://cocoonbox_api:...@127.0.0.1:5432/cocoonbox
  master_key_file: master.key  # 32 random bytes: head -c 32 /dev/urandom
