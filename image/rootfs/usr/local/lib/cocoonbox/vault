#!/bin/sh
# renders the claim env's COCOONBOX_VAULT (NAME=placeholder;hosts;how words) into shell exports and the box agent's key list
set -euf
dir=/run/cocoonbox-vault
umask 022
mkdir -p "$dir"
records=${COCOONBOX_VAULT:-}
known=$(cat "$dir/names" 2>/dev/null || true)
names=""
: > "$dir/.vault.sh"
: > "$dir/.keys"
for r in $records; do
	kv=${r%%;*}
	name=${kv%%=*} placeholder=${kv#*=}
	case $name$placeholder in *[!A-Za-z0-9_-]* | '') continue ;; esac
	printf "export %s='%s'\n" "$name" "$placeholder" >> "$dir/.vault.sh"
	printf '%s\n' "$r" >> "$dir/.keys"
	names="$names $name"
done
# a persistent shell that saw a deleted key drops it on its next source
for n in $known; do
	case " $names " in *" $n "*) ;; *) printf 'unset %s\n' "$n" >> "$dir/.vault.sh" ;; esac
done
printf '%s\n' $known $names | sort -u > "$dir/.names"
mv -f "$dir/.vault.sh" "$dir/vault.sh"
mv -f "$dir/.names" "$dir/names"
if [ -s "$dir/.keys" ]; then mv -f "$dir/.keys" "$dir/keys"; else rm -f "$dir/.keys" "$dir/keys"; fi
