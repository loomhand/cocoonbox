#!/bin/sh
set -eu
# xfce4-session keeps its saves in ~/.cache/sessions, which the state layer skips; the link moves them to ~/.local/state
state=$HOME/.local/state/xfce4-session
mkdir -p "$state" "$HOME/.cache"
[ -L "$HOME/.cache/sessions" ] || { rm -rf "$HOME/.cache/sessions"; ln -s ../.local/state/xfce4-session "$HOME/.cache/sessions"; }
current="$state/xfce4-session-$(uname -n):0"
newest=$(ls -t "$state"/xfce4-session-*:0 2>/dev/null | head -n 1)
[ -e "$current" ] || [ -z "$newest" ] || mv "$newest" "$current"
until xset -q >/dev/null 2>&1; do sleep 0.5; done
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP GTK_MODULES QT_ACCESSIBILITY
xset s off s noblank -dpms
exec startxfce4
