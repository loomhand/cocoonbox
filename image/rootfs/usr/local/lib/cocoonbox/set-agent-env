#!/bin/sh
# usage: set-agent-env < agent.env  (installs /etc/cocoonbox/agent.env root:cbagent 0640)
set -eu
tmp=$(mktemp /etc/cocoonbox/.agent.env.XXXXXX)
cat > "$tmp"
for k in GW_BASE_URL GW_API_KEY MODEL_MAIN MODEL_COMPUTER AGENT_LISTEN; do
	grep -q "^$k=." "$tmp" || { rm -f "$tmp"; echo "set-agent-env: missing $k" >&2; exit 1; }
done
chown root:cbagent "$tmp"
chmod 0640 "$tmp"
mv -f "$tmp" /etc/cocoonbox/agent.env
