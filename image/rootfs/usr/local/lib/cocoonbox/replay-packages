#!/bin/sh
# installs the packages of the desktop user's package file that this machine lacks; one failure never blocks the rest
set -u
list=/home/user/.config/cocoonbox/packages
[ -f "$list" ] || exit 0
missing=""
for p in $(grep -E '^[a-z0-9][a-z0-9+.-]*(:[a-z0-9]+)?$' "$list"); do
	[ "$(dpkg-query -W -f='${db:Status-Status}' "$p" 2>/dev/null)" = installed ] || missing="$missing $p"
done
[ -n "$missing" ] || { echo "packages: none missing"; exit 0; }
echo "packages: installing$missing"
printf '%s\n' $missing > /etc/cocoonbox/packages.pending
export DEBIAN_FRONTEND=noninteractive
apt_install() {
	out=$(apt-get -o DPkg::Lock::Timeout=120 install -y -q "$@" 2>&1)
	rc=$?
	printf '%s\n' "$out" | grep -v '^Waiting for cache lock'
	[ "$rc" -eq 0 ] && return 0
	if printf '%s\n' "$out" | grep -qE '^E: (Could not get lock|Unable to acquire the dpkg)'; then echo "packages: dpkg is locked; retrying later"; exit 75; fi
	return "$rc"
}
apt-get -o DPkg::Lock::Timeout=120 update -q || echo "packages: apt-get update failed"
apt_install $missing && { echo "packages: installed$missing"; exit 0; }
rc=0
for p in $missing; do
	if apt_install "$p"; then echo "packages: installed $p"; else echo "packages: failed $p"; rc=1; fi
done
exit $rc
