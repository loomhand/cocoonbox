[Unit]
Description=cua-driver daemon on display :0

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/cocoonbox-x/Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=CUA_DRIVER_RS_TELEMETRY_ENABLED=false
ExecStartPre=/bin/sh -c 'until [ -S /tmp/.X11-unix/X0 ] && [ -S /run/user/1000/bus ]; do sleep 0.5; done'
ExecStart=/usr/local/bin/cua-driver serve
TimeoutStartSec=300
Restart=always
RestartSec=3s

[Install]
WantedBy=default.target
