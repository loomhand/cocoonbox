[Unit]
Description=cocoonbox tool host (runs every tool as user)
ConditionPathExists=/usr/local/bin/cocoonbox-agent
After=cocoonbox-session.service user@1000.service

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/workspace
Environment=HOME=/home/user
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/cocoonbox-x/Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/local/bin/cocoonbox-agent toolhost
Restart=always
RestartSec=2s

[Install]
WantedBy=graphical.target
