<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.loomhand.cocoonbox-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/lib/cocoonbox/serve</string>
	</array>
	<key>UserName</key>
	<string>_cbagent</string>
	<key>GroupName</key>
	<string>cbagent</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>3</integer>
	<key>StandardErrorPath</key>
	<string>/var/log/cocoonbox-agent.log</string>
</dict>
</plist>
