[Unit]
Description=shuttle desk daemon on the box's Android device
After=cocoonbox-redroid.service
ConditionPathExists=/usr/local/bin/shuttle

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/workspace
Environment=HOME=/home/user
Environment=LANG=en_US.UTF-8
Environment=ANDROID_SERIAL=127.0.0.1:5555
ExecStartPre=/usr/local/lib/cocoonbox/shuttle-config
ExecStart=/usr/local/bin/shuttle serve /run/cocoonbox/desk.sock
Restart=always
RestartSec=2s
OOMScoreAdjust=-900
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
