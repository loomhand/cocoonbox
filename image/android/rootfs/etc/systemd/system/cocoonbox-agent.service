[Unit]
Description=cocoonbox in-box agent loop
ConditionPathExists=/usr/local/bin/cocoonbox-agent
Wants=network-online.target shuttle.service
After=network-online.target shuttle.service

[Service]
Type=simple
User=cbagent
Group=cbagent
EnvironmentFile=/etc/cocoonbox/agent.env
Environment=SHUTTLE_SOCKET=/run/cocoonbox/desk.sock
Environment=TOOLHOST_SOCKET=/run/cocoonbox/desk.sock
ExecStart=/usr/local/bin/cocoonbox-agent serve
StateDirectory=cocoonbox
StateDirectoryMode=0700
Restart=always
RestartSec=2s
TimeoutStopSec=5s
OOMScoreAdjust=-900
MemoryLow=64M

[Install]
WantedBy=multi-user.target
