#!/bin/bash
# Applies ~user/.android/data.tar to Android's /data once per verified tar; the old /data stays unless the whole tar
# extracts and mounts, failures are logged, and only a failed rollback leaves Android stopped.
set -uo pipefail
TOP=/var/lib/cocoonbox-android/fs
DIR=/home/user/.android
STAMP=/var/lib/cocoonbox-android/applied.sha256
DATA=/var/lib/redroid-data

log() { echo "android-apply: $*" >&2; }

rollback() {
	if [ -d "$TOP/old" ]; then
		! mountpoint -q "$DATA" || umount "$DATA" || return 1
		[ ! -d "$TOP/data" ] || mv "$TOP/data" "$TOP/new" || return 1
		mv "$TOP/old" "$TOP/data" || return 1
	fi
	mountpoint -q "$DATA" || mount --bind "$TOP/data" "$DATA"
}

[ -f "$DIR/data.tar" ] || exit 0
exec 9>/run/cocoonbox-android.lock
flock 9
sum=$(cut -d' ' -f1 "$DIR/data.tar.sha256" 2>/dev/null) || sum=none
[ "$sum" != "$(cat "$STAMP" 2>/dev/null)" ] || exit 0
if ! (cd "$DIR" && sha256sum --quiet -c data.tar.sha256 >/dev/null 2>&1); then
	log "refused data.tar $sum: it does not match data.tar.sha256; /data stays"
	exit 0
fi
/usr/local/lib/cocoonbox/android-mount || { log "mount /data failed"; exit 0; }
running=false
if systemctl -q is-active docker.service; then
	running=true
	systemctl stop cocoonbox-redroid.service || { log "stop cocoonbox-redroid failed; /data stays"; exit 1; }
fi
btrfs -q subvolume delete "$TOP/new" >/dev/null 2>&1 || true
! mountpoint -q "$DATA" || btrfs -q subvolume delete "$TOP/old" >/dev/null 2>&1 || true
if btrfs -q subvolume create "$TOP/new" &&
	tar -C "$TOP/new" --numeric-owner --xattrs --xattrs-include='*' -xpf "$DIR/data.tar"; then
	if umount "$DATA" && mv "$TOP/data" "$TOP/old" && mv "$TOP/new" "$TOP/data" && mount --bind "$TOP/data" "$DATA"; then
		if echo "$sum" > "$STAMP"; then
			btrfs -q subvolume delete "$TOP/old" >/dev/null 2>&1 || true
			log "applied data.tar $sum"
		else
			log "applied data.tar $sum, but writing its stamp failed; the old /data stays until the next apply"
		fi
	else
		log "swap to data.tar $sum failed; /data stays"
		rollback || { log "putting the old /data back failed; Android stays stopped"; exit 1; }
	fi
else
	log "extract of data.tar $sum failed; /data stays"
fi
btrfs -q subvolume delete "$TOP/new" >/dev/null 2>&1 || true
mountpoint -q "$DATA" || { log "/data is not mounted; Android stays stopped"; exit 1; }
if [ "$running" = true ]; then
	systemctl start cocoonbox-redroid.service || log "start cocoonbox-redroid failed"
fi
exit 0
